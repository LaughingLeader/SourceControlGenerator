<rxui:ReactiveUserControl x:Class="SCG.BG3.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SCG.BG3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="http://reactiveui.net"
    xmlns:vm="clr-namespace:SCG.BG3.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vm:MainViewViewModel"
    mc:Ignorable="d">
	<UserControl.Resources>
		<DataTemplate x:Key="GridViewTextblockHeaderTemplate">
			<TextBlock Margin="2,0,2,0" Text="{Binding}" />
		</DataTemplate>

		<ToolTip x:Key="ProjectToolTip">
			<StackPanel Orientation="Vertical">
				<TextBlock>
					<Run Text="{Binding DisplayName, Mode=OneWay}" />
					<Run Text="{Binding Version, Mode=OneWay}" />
				</TextBlock>
				<Image Source="{Binding Thumbnail}" Visibility="{Binding HasThumbnail}" />
			</StackPanel>
		</ToolTip>

	</UserControl.Resources>
	<Grid>
		<ListView x:Name="ProjectsListView">
			<ListView.ItemContainerStyle>
				<Style TargetType="ListViewItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				</Style>
			</ListView.ItemContainerStyle>
			<ListView.View>
				<GridView>
					<GridView.Columns>
						<GridViewColumn Width="400" Header="Name" HeaderTemplate="{StaticResource GridViewTextblockHeaderTemplate}">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<Border Padding="0,2"
									    HorizontalAlignment="Stretch"
									    ToolTip="{StaticResource ProjectToolTip}"
									    ToolTipService.InitialShowDelay="250">
										<TextBlock Text="{Binding DisplayName}" TextAlignment="Left" />
									</Border>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>

						<GridViewColumn Width="80" Header="Version" HeaderTemplate="{StaticResource GridViewTextblockHeaderTemplate}">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Version}" TextAlignment="Left" ToolTip="{Binding Version}" />
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
					</GridView.Columns>
				</GridView>
			</ListView.View>
		</ListView>
	</Grid>
</rxui:ReactiveUserControl>
