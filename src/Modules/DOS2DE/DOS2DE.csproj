<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Module.props" />
	
	<PropertyGroup>
		<UseWPF>true</UseWPF>
		
		<RootNamespace>SCG.Modules.DOS2DE</RootNamespace>
		
		<AssemblyName>SCG.Modules.DOS2DE</AssemblyName>
		<AssemblyTitle>SCG-DOS2</AssemblyTitle>
		<AssemblyProduct>SCG-DOS2</AssemblyProduct>
		<AssemblyDescription>Divinity: Original Sin 2 - Definitive Edition support for Source Control Generator.</AssemblyDescription>
		<AssemblyCompany>LaughingLeader</AssemblyCompany>
		<AssemblyCopyright>Copyright © LaughingLeader 2018</AssemblyCopyright>
		
		<AssemblyVersion>1.2.0.0</AssemblyVersion>
		<AssemblyFileVersion>1.2.0.0</AssemblyFileVersion>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\..\..\External\lslib\LSLib\LSLib.csproj" />
		<ProjectReference Include="..\..\..\External\lslib\LSLibNative\LSLibNative.vcxproj" />
	</ItemGroup>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<ItemGroup>
			<LSLib Include="$(OutputPath)LSLib.dll;$(OutputPath)LSLibNative.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(LSLib)" DestinationFolder="$(SolutionDir)bin\$(Configuration)\_Lib\" OverwriteReadOnlyFiles="true" />
	</Target>
</Project>