<UserControl x:Class="SCG.Controls.TemplateEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:cmd="clr-namespace:SCG.Commands"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SCG.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vdata="clr-namespace:SCG.Data.View"
    x:Name="TemplateEditorMain"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
	<UserControl.Resources />
	<UserControl.InputBindings>
		<KeyBinding Command="{Binding SaveCommand}" CommandParameter="{Binding SaveCommandParameters}" Gesture="CTRL+S" />
		<KeyBinding Command="{Binding SaveAsCommand}" CommandParameter="{Binding SaveCommandParameters}" Gesture="CTRL+Alt+S" />
	</UserControl.InputBindings>
	<Grid x:Name="Editor_ParentGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid x:Name="HeaderControls" Grid.Row="0" adonisExtensions:LayerExtension.IncreaseLayer="True">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Label x:Name="TemplateLabel"
			    Width="Auto"
			    Margin="2,0"
			    HorizontalAlignment="Left"
			    VerticalAlignment="Center"
			    Content="{Binding LabelText}"
			    ToolTip="{Binding ToolTipText}">
				<Label.Style>
					<Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />
						<Style.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Foreground" Value="#FF3A6FFF" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</Label.Style>
			</Label>
			<Grid Grid.Column="1" Margin="4" adonisExtensions:LayerExtension.IncreaseLayer="True">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<local:FileBrowseControl x:Name="TemplateFileBrowser"
				    FileLocationText="{Binding FilePath}"
				    OnOpen="{Binding OpenCommand}"
				    OpenFileText="{Binding OpenFileText}" />
				<StackPanel x:Name="KeywordCommandsGrid"
				    Grid.Column="1"
				    HorizontalAlignment="Right"
				    adonisExtensions:LayerExtension.IncreaseLayer="True"
				    Orientation="Horizontal">
					<StackPanel.Resources>
						<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
							<Setter Property="Margin" Value="2,0,0,0" />
							<Setter Property="Padding" Value="4,2" />
							<Setter Property="BorderBrush" Value="{Binding Path=BorderBrush, ElementName=KeywordFileBrowser, FallbackValue='#FFABADB3'}" />
							<Setter Property="Height" Value="{Binding Path=Height, ElementName=TemplateFileBrowser}" />
						</Style>
						<Style BasedOn="{StaticResource {x:Type local:ImageButton}}" TargetType="local:ImageButton">
							<Setter Property="Margin" Value="2,0,1,0" />
						</Style>
					</StackPanel.Resources>
					<!--<local:ImageButton Source="{x:Static vdata:IconPathData.Save}"
						Command="{Binding SaveCommand}" CommandParameter="{Binding SaveCommandParameters}"
						Click="SaveButton_Click"
					/>
					<local:ImageButton Source="{x:Static vdata:IconPathData.SaveAs}"
						Command="{Binding SaveAsCommand}" CommandParameter="{Binding SaveCommandParameters}"
					/>-->
					<Button x:Name="SaveButton"
					    Click="SaveButton_Click"
					    Command="{Binding SaveCommand}"
					    CommandParameter="{Binding SaveCommandParameters}"
					    Content="Save" />
					<Button x:Name="SaveAsButton"
					    Command="{Binding SaveAsCommand}"
					    CommandParameter="{Binding SaveCommandParameters}"
					    Content="Save As..." />
				</StackPanel>
			</Grid>
		</Grid>
		<Border Grid.Row="1"
		    Width="Auto"
		    adonisExtensions:LayerExtension.IncreaseLayer="True"
		    BorderThickness="1">
			<TextBox x:Name="TemplateText"
			    Width="Auto"
			    Height="Auto"
			    Margin="0"
			    Padding="0"
			    adonisExtensions:LayerExtension.IncreaseLayer="True"
			    AcceptsReturn="True"
			    HorizontalScrollBarVisibility="Auto"
			    Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			    VerticalScrollBarVisibility="Auto" />
		</Border>
		<Grid x:Name="EditorCommands" Grid.Row="2" adonisExtensions:LayerExtension.IncreaseLayer="True">
			<StackPanel>
				<Button x:Name="DefaultButton"
				    adonisExtensions:LayerExtension.IncreaseLayer="True"
				    Click="DefaultButton_Click"
				    Content="Reset to Default..."
				    ToolTip="Discard changes and reset to application default." />
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
