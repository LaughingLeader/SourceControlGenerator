<UserControl x:Class="SCG.Controls.FileBrowseControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:SCG.Controls.Behavior"
    xmlns:c="clr-namespace:SCG.Controls"
    xmlns:conv="clr-namespace:SCG.Converters"
    xmlns:core="clr-namespace:SCG.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="clr-namespace:SCG.SCGEnum"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vdata="clr-namespace:SCG.Data.View"
    x:Name="FileBrowser"
    Width="Auto"
    Height="Auto"
    Margin="0"
    Padding="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DesignHeight="22"
    d:DesignWidth="300"
    BorderBrush="#FFABADB3"
    BorderThickness="1"
    mc:Ignorable="d">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/SourceControlGenerator;component/ThemeSystem/ResourceDictionary/MainAppDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="1" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>
		<Rectangle Grid.Row="0" Fill="{Binding Path=FileValidation, ElementName=FileBrowser, Converter={StaticResource FileValidationColorConverter}, FallbackValue=Wheat}" IsHitTestVisible="False" />
		<Rectangle Grid.Column="1"
		    Margin="0"
		    IsHitTestVisible="False"
		    Stroke="{Binding Path=BorderBrush, ElementName=FileBrowser}"
		    Style="{StaticResource VerticalSeparator}" />
		<TextBox x:Name="FilePathDisplay"
		    Grid.Column="0"
		    VerticalAlignment="Center"
		    behavior:TextBoxEnterKeyBehavior.EnterLosesFocus="True"
		    Background="Transparent"
		    BorderThickness="0"
		    IsReadOnly="False"
		    Tag="{Binding RelativeSource={RelativeSource Mode=Self}}"
		    Text="{Binding Path=FileLocationText, ElementName=FileBrowser, Mode=TwoWay, FallbackValue='Test'}"
		    TextAlignment="Right"
		    ToolTip="{Binding Path=FileLocationText, ElementName=FileBrowser}">
			<TextBox.ContextMenu>
				<ContextMenu DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
					<MenuItem Click="CutSelectedToClipboard" Header="Cut" IsEnabled="{Binding SelectedText, Converter={StaticResource StringToBoolConverter}}" />
					<MenuItem Click="CopySelectedToClipboard" Header="Copy Selected" IsEnabled="{Binding SelectedText, Converter={StaticResource StringToBoolConverter}}" />
					<MenuItem Click="CopyAllToClipboard" Header="Copy All" IsEnabled="{Binding Text, Converter={StaticResource StringToBoolConverter}}" />
					<MenuItem Click="PasteFromClipboard" Header="Paste" IsEnabled="{Binding Source={x:Static core:AppController.Main}, Path=Data.ClipboardPopulated}" />
					<MenuItem Click="ReplaceFromClipboard" Header="Paste (Replace)" IsEnabled="{Binding Source={x:Static core:AppController.Main}, Path=Data.ClipboardPopulated}" />
					<MenuItem Click="ClearFileLocationText" Header="Clear" IsEnabled="{Binding Text, Converter={StaticResource StringToBoolConverter}}" />
				</ContextMenu>
			</TextBox.ContextMenu>
		</TextBox>
		<Button x:Name="FileBrowseButton"
		    Grid.Column="2"
		    Width="Auto"
		    Height="Auto"
		    MinWidth="38"
		    HorizontalContentAlignment="Center"
		    VerticalContentAlignment="Center"
		    Background="LightGray"
		    BorderBrush="{x:Null}"
		    BorderThickness="0"
		    Click="FileBrowseButton_Click"
		    ToolTip="{Binding Path=BrowseToolTip, ElementName=FileBrowser}">
			<Button.Resources>
				<Style TargetType="Ellipse">
					<Setter Property="Width" Value="{Binding CircleSize, ElementName=FileBrowser, FallbackValue=4}" />
					<Setter Property="Height" Value="{Binding CircleSize, ElementName=FileBrowser, FallbackValue=4}" />
					<Setter Property="Fill" Value="Black" />
					<Setter Property="Margin" Value="1" />
				</Style>
			</Button.Resources>
			<Viewbox Stretch="UniformToFill" StretchDirection="DownOnly">
				<StackPanel Orientation="Horizontal">
					<Ellipse />
					<Ellipse />
					<Ellipse />
				</StackPanel>
			</Viewbox>
		</Button>
		<!--<c:ImageButton
			x:Name="FileBrowseButton" Grid.Column="2"
			InitialSize="16" Margin="2"
			ToolTip="{Binding Path=BrowseToolTip, ElementName=FileBrowser}"
