<local:HideWindowBase x:Class="SCG.Windows.MarkdownConverterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:SCG.Controls.Behavior"
    xmlns:c="clr-namespace:SCG.Controls"
    xmlns:converter="clr-namespace:SCG.Converters"
    xmlns:core="clr-namespace:SCG.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SCG.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
    xmlns:scg="clr-namespace:SCG"
    xmlns:vdata="clr-namespace:SCG.Data.View"
    Title="Markdown Converter"
    Width="1200"
    Height="768"
    mc:Ignorable="d">
	<local:HideWindowBase.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/SourceControlGenerator;component/ThemeSystem/ResourceDictionary/MainAppDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<vdata:MarkdownConverterModeToColumnWidthConverter x:Key="MarkdownConverterModeToColumnWidthConverter" />
		</ResourceDictionary>
	</local:HideWindowBase.Resources>
	<local:HideWindowBase.InputBindings>
		<KeyBinding Key="Tab" Command="{Binding NextModeCommand}" Modifiers="Shift" />
		<KeyBinding Key="S" Command="{Binding SaveInputCommand}" Modifiers="Ctrl" />
	</local:HideWindowBase.InputBindings>
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Menu MinHeight="10"
		    Padding="0"
		    Background="Transparent"
		    ItemContainerTemplateSelector="{StaticResource MenuItemContainerTemplateSelector}"
		    ItemsSource="{Binding TopMenus}"
		    UsesItemContainerTemplate="True" />
		<Grid Grid.Row="1">
			<Grid.Resources>
				<Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
					<EventSetter Event="Click" Handler="Control_InvokeDataSaving" />
				</Style>
				<Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
					<EventSetter Event="SelectionChanged" Handler="Control_InvokeDataSaving" />
				</Style>
			</Grid.Resources>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid Margin="4,4,8,4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<c:FileBrowseControl x:Name="InputOpenFileBrowser"
				    Width="Auto"
				    MinHeight="22"
				    Margin="0,0,4,0"
				    BrowseMode="Open"
				    BrowseToolTip="{x:Static core:TooltipText.MarkdownConverterSingleModeInputFileBrowser}"
				    BrowseType="File"
				    FileLocationText="{Binding SingleModeLastFileInputPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
				    Filters="{x:Static core:CommonFileFilters.MarkdownConverterFilesList}"
				    LastFileLocation="{Binding SingleModeLastFileInputPath, Mode=OneTime}"
				    OnOpen="{Binding OpenInputFileCommand}"
				    OpenFileText="Open file as input..." />
				<StackPanel Grid.Column="1"
				    HorizontalAlignment="Center"
				    VerticalAlignment="Center"
				    behavior:MarginSetter.Margin="4,0,4,0"
				    Orientation="Horizontal"
				    ToolTip="{x:Static core:TooltipText.MarkdownConverterModeShortcut}">
					<TextBlock VerticalAlignment="Center" Text="Mode:" TextAlignment="Left" />
					<ComboBox Width="Auto" ItemsSource="{Binding Source={scg:EnumBindingSource {x:Type vdata:MarkdownConverterMode}}}" SelectedValue="{Binding Path=Mode, Mode=TwoWay}" />
				</StackPanel>
				<StackPanel Grid.Column="2"
				    HorizontalAlignment="Center"
				    VerticalAlignment="Center"
				    Orientation="Horizontal">
					<TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="Input Type:" />
					<ComboBox Width="Auto" ItemsSource="{Binding Source={scg:EnumBindingSource {x:Type vdata:MarkdownInputType}}}" SelectedValue="{Binding Path=InputType, Mode=TwoWay}" />
				</StackPanel>
			</Grid>

			<Grid Grid.Column="1" Margin="8,0,0,0">
				<Grid Visibility="{Binding SingleMode, FallbackValue=Visible}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="2*" />
					</Grid.ColumnDefinitions>
					<Grid Margin="0,4,4,4" VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Formatters}" SelectedValue="{Binding SelectedFormatter, Mode=TwoWay}" />
						<Button Grid.Column="1"
						    Margin="4,0,0,0"
						    Command="{Binding PreviewSingleCommand}"
						    Content="Preview"
						    IsEnabled="{Binding CanPreview}" />
					</Grid>
					<Grid Grid.Column="1"
					    Margin="4"
					    HorizontalAlignment="Stretch"
					    VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<c:FileBrowseControl x:Name="SingleModeFileBrowser"
						    Width="Auto"
						    Height="16"
						    MinHeight="22"
						    BrowseMode="Save"
						    BrowseToolTip="{x:Static core:TooltipText.MarkdownConverterSingleModeOutputFileBrowser}"
						    BrowseType="File"
						    DefaultExt=".txt"
						    DefaultFileName="{Binding SingleModeDefaultFileName}"
						    FileLocationText="{Binding SingleModeLastFileExportPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
						    Filters="{x:Static core:CommonFileFilters.MarkdownConverterFilesList}"
						    LastFileLocation="{Binding SingleModeLastFileExportPath, Mode=OneTime}"
						    OnOpen="{Binding OpenInputFileCommand}"
						    OpenFileText="Save output to..." />
						<Button x:Name="SingleModeSaveButton"
						    Grid.Column="1"
						    Margin="4,0,0,0"
						    Command="{Binding ExportSingleCommand}"
						    Content="Export"
						    IsEnabled="{Binding CanExport}" />
					</Grid>
				</Grid>
				<Grid HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding BatchMode, FallbackValue=Collapsed}">
					<Button Command="{Binding BatchExportCommand}" Content="Export All Selected" IsEnabled="{Binding CanBatchExport}" />
				</Grid>
			</Grid>


			<Grid Grid.Row="1" Grid.ColumnSpan="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="{Binding Path=Mode, Converter={StaticResource MarkdownConverterModeToColumnWidthConverter}, ConverterParameter={x:Static vdata:MarkdownConverterMode.Batch}, FallbackValue='Auto', Mode=OneWay}" />
					<ColumnDefinition Width="{Binding Path=Mode, Converter={StaticResource MarkdownConverterModeToColumnWidthConverter}, ConverterParameter={x:Static vdata:MarkdownConverterMode.Single}, FallbackValue='*', Mode=OneWay}" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<TextBlock Margin="4" Text="Input" TextAlignment="Center" />
				<Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
					<TabControl>
						<TabControl.Resources>
							<SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF" />
							<SolidColorBrush x:Key="SolidBorderBrush" Color="#888" />
							<SolidColorBrush x:Key="DisabledForegroundBrush" Color="#888" />
							<SolidColorBrush x:Key="DisabledBorderBrush" Color="#AAA" />
						</TabControl.Resources>
						<TabControl.Template>
							<ControlTemplate TargetType="TabControl">
								<Grid KeyboardNavigation.TabNavigation="Local">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="*" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TabPanel Name="HeaderPanel"
									    Grid.Row="0"
									    Margin="2,0,4,-1"
									    Panel.ZIndex="1"
									    Background="Transparent"
									    IsItemsHost="True"
									    KeyboardNavigation.TabIndex="1" />
									<Border Name="Border"
									    Grid.Row="1"
									    Grid.ColumnSpan="2"
									    Background="{StaticResource WindowBackgroundBrush}"
									    BorderBrush="{StaticResource SolidBorderBrush}"
									    BorderThickness="1"
									    CornerRadius="2"
									    KeyboardNavigation.DirectionalNavigation="Contained"
									    KeyboardNavigation.TabIndex="2"
									    KeyboardNavigation.TabNavigation="Local">
										<ScrollViewer Margin="0,1,0,0" HorizontalScrollBarVisibility="{Binding TextWrapMode, Converter={StaticResource TextWrapToScrollBarVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
											<ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
										</ScrollViewer>
									</Border>
									<Grid Grid.Column="1">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<StackPanel Margin="0,0,64,0" Orientation="Horizontal">
											<TextBlock VerticalAlignment="Center" Text="Text Wrap: " />
											<ComboBox Width="Auto"
											    VerticalAlignment="Center"
											    ItemsSource="{Binding Source={scg:EnumBindingSource {x:Type TextWrapping}}}"
											    SelectedValue="{Binding Path=TextWrapMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
										</StackPanel>
										<Button Grid.Column="1"
										    VerticalAlignment="Center"
										    Command="{Binding SaveInputCommand}"
										    Content="Save"
										    IsEnabled="{Binding CanSaveInput}"
										    ToolTip="{x:Static core:TooltipText.MarkdownConverterSaveInputFile}" />
									</Grid>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsEnabled" Value="False">
										<Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
										<Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</TabControl.Template>
						<TabItem Header="Text">
							<TextBox AcceptsReturn="True"
							    AcceptsTab="True"
							    BorderThickness="0"
							    Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
							    TextWrapping="{Binding TextWrapMode, FallbackValue=Wrap}" />
						</TabItem>
						<TabItem>
							<TabItem.Header>
								<Label x:Name="InputPreviewLabel" Content="Preview" MouseLeftButtonDown="InputPreviewLabel_MouseLeftButtonDown" />
							</TabItem.Header>
							<mdxam:MarkdownScrollViewer x:Name="MarkdownViewer" xml:space="preserve" Markdown="{Binding Input}" />
						</TabItem>
					</TabControl>
				</Grid>

				<Grid Grid.Row="1" Grid.Column="1">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<ScrollViewer BorderBrush="Red"
					    BorderThickness="1"
					    VerticalScrollBarVisibility="Auto"
					    Visibility="{Binding BatchMode, FallbackValue=Collapsed}">
						<ItemsControl x:Name="BatchFormattersControl"
						    Margin="4,0,4,0"
						    Grid.IsSharedSizeScope="True"
						    ItemsSource="{Binding BatchFormatterData}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
											<ColumnDefinition Width="2*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<CheckBox Margin="4"
										    HorizontalAlignment="Center"
										    VerticalAlignment="Center"
										    IsChecked="{Binding Enabled, Mode=TwoWay}" />
										<TextBlock Grid.Column="1"
										    Margin="4"
										    VerticalAlignment="Center"
										    Text="{Binding Name}"
										    TextAlignment="Left" />
										<c:FileBrowseControl Grid.Column="2"
										    Margin="4"
										    BrowseMode="Save"
										    BrowseToolTip="{x:Static core:TooltipText.MarkdownConverterBatchModeExportFileBrowser}"
										    BrowseType="File"
										    DefaultExt="{Binding DefaultFileExtension}"
										    DefaultFileName="{Binding DefaultFileName}"
										    FileLocationText="{Binding FilePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
										    Filters="{x:Static core:CommonFileFilters.MarkdownConverterFilesList}"
										    LastFileLocation="{Binding LastPath}"
										    OnOpen="{Binding OnFilePathSet}"
										    OpenFileText="{Binding OpenFileText}" />
										<Button Grid.Column="3"
										    Margin="4"
										    Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
										    CommandParameter="{Binding Formatter}"
										    Content="Preview"
										    IsEnabled="{Binding DataContext.CanPreview, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
					<Grid x:Name="BatchOutputPreview" Grid.Row="1" Visibility="{Binding BatchMode, FallbackValue=Collapsed}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<TextBlock Margin="4" Text="Output Preview" TextAlignment="Center" />
						<Grid Grid.Row="1" Margin="8,0,0,0">
							<TextBox AcceptsReturn="True"
							    AcceptsTab="True"
							    HorizontalScrollBarVisibility="{Binding TextWrapMode, Converter={StaticResource TextWrapToScrollBarVisibilityConverter}}"
							    IsReadOnly="True"
							    Text="{Binding Output, FallbackValue=''}"
							    TextWrapping="{Binding TextWrapMode, FallbackValue=Wrap}"
							    VerticalScrollBarVisibility="Auto" />
						</Grid>
					</Grid>
				</Grid>

				<TextBlock Grid.Column="2"
				    Margin="4"
				    Text="Output Preview"
				    TextAlignment="Center"
				    Visibility="{Binding SingleMode, FallbackValue=Visible}" />
				<Grid x:Name="OutputGrid"
				    Grid.Row="1"
				    Grid.Column="2"
				    Margin="8,0,0,0"
				    Visibility="{Binding SingleMode, FallbackValue=Visible}">
					<TextBox AcceptsReturn="True"
					    AcceptsTab="True"
					    HorizontalScrollBarVisibility="{Binding TextWrapMode, Converter={StaticResource TextWrapToScrollBarVisibilityConverter}}"
					    IsReadOnly="True"
					    Text="{Binding Output, FallbackValue=''}"
					    TextWrapping="{Binding TextWrapMode, FallbackValue=Wrap}"
					    VerticalScrollBarVisibility="Auto" />
				</Grid>
				<Grid x:Name="BatchOutputGrid"
				    Grid.Row="1"
				    Grid.Column="2"
				    Visibility="{Binding SingleMode, FallbackValue=Visible}" />
			</Grid>
		</Grid>
	</Grid>
</local:HideWindowBase>
