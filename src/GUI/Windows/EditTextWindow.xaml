<Window x:Class="SCG.Windows.EditTextWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SCG.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="EditWindow"
    Title="EditTextWindow"
    Width="800"
    Height="600"
    Closed="EditWindow_Closed"
    FocusManager.FocusedElement="{Binding ElementName=EditTextBox}"
    mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Border Margin="2" adonisExtensions:LayerExtension.IncreaseLayer="True" BorderThickness="0.5">
			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
				<TextBox x:Name="EditTextBox"
				    adonisExtensions:LayerExtension.IncreaseLayer="True"
				    AcceptsReturn="True"
				    Background="{x:Null}"
				    Text="{Binding Text, ElementName=EditWindow, Mode=TwoWay}" />
			</ScrollViewer>
		</Border>
		<UniformGrid Grid.Row="1"
		    HorizontalAlignment="Center"
		    VerticalAlignment="Center"
		    adonisExtensions:LayerExtension.IncreaseLayer="True"
		    Columns="2"
		    Rows="1">
			<Button x:Name="ConfirmButton"
			    Grid.Column="0"
			    Margin="5,5,2.5,5"
			    Click="ConfirmButton_Click"
			    Content="OK" />
			<Button x:Name="CancelButton"
			    Grid.Column="1"
			    Margin="2.5,5,5,5"
			    Padding="5"
			    Click="CancelButton_Click"
			    Content="Cancel" />
		</UniformGrid>
	</Grid>
</Window>
